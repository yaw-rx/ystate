{
  "name": "@yaw-rx/ystate-studio",
  "version": "0.1.0",
  "description": "A studio for finite state machines",
  "keywords": [
    "FSM",
    "YState",
    "Visualiser",
    "Studio"
  ],
  "license": "MIT",
  "author": "Jonathan Kelsey",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "ts-patch install",
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "typecheck": "tsc --build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "build:ssg:deep-routes": "yaw-ssg dist public && node scripts/deep-routes.mjs public"
  },
  "dependencies": {
    "@yaw-rx/core": "^0.1.2",
    "elkjs": "^0.11.1",
    "monaco-editor": "^0.55.1",
    "rxjs": "8.0.0-alpha.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@yaw-rx/ssg": "^0.1.1",
    "@yaw-rx/transformer": "^0.1.1",
    "@yaw-rx/ts-plugin": "^0.1.1",
    "@yaw-rx/vite": "^0.1.1",
    "esbuild-loader": "^4.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "ts-patch": "^4.0.1",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.16"
  }
}
